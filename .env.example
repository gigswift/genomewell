# Chronic Wellness — Environment Variables
# Copy this file to .env and fill in the values before running the dev server.
#
# Get your API key at: https://console.anthropic.com/
#
# IMPORTANT: For production, proxy the Claude API call through a serverless function
# (e.g. a Vercel Edge Function) so this key is never exposed client-side.
# This MVP uses a direct browser call for simplicity.

VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Affiliate links: no env vars needed. URLs in docs/catalogue/herbspro_products.csv
# are pre-tagged Rakuten LinkShare deeplinks (id=lDiltZ8gZ2U baked in). The runtime
# uses each URL verbatim — see src/lib/affiliateLinks.ts.

# Google Ads conversion tracking — set in Vercel project settings for production.
# The account ID plus the matching per-event label must both be present for a
# gtag conversion to fire; if either is missing, that gtag call is silently
# skipped and /api/track still logs the event.
# AdWords account conversion ID, e.g. AW-1234567890
VITE_GOOGLE_ADS_ID=
# Conversion label for the affiliate-click event (fires when a Shop button is
# clicked). Second half of the send_to value Google Ads gives you, after the slash.
VITE_GOOGLE_ADS_LABEL_AFFILIATE_CLICK=
# Conversion label for the file-parsed event (fires once per successful DNA
# parse). Second half of the send_to value Google Ads gives you, after the slash.
VITE_GOOGLE_ADS_LABEL_FILE_PARSED=
# Conversion label for the page-view event (fires once per page load at app
# bootstrap). From the 'Page View' Conversion Action in Google Ads.
VITE_GOOGLE_ADS_LABEL_PAGE_VIEW=ReplaceWithRealLabel
